ASGARDIAN_ENV=development
ASGARDIAN_DATABASE_URL=postgresql+psycopg://asgardian:asgardian@localhost:5432/asgardian
ASGARDIAN_REDIS_URL=redis://localhost:6379/0
# solo: all jobs use ASGARDIAN_COMFY_URL; split: image and video URLs are mandatory and distinct.
ASGARDIAN_ENGINE_ROUTING_MODE=solo
ASGARDIAN_COMFY_URL=http://comfyui.example.local:8188
ASGARDIAN_COMFY_IMAGE_URL=
ASGARDIAN_COMFY_VIDEO_URL=
ASGARDIAN_S3_ENDPOINT=https://s3.example.local
ASGARDIAN_S3_ACCESS_KEY=replace-me
ASGARDIAN_S3_SECRET_KEY=replace-me
ASGARDIAN_S3_BUCKET=artefacts
ASGARDIAN_S3_TLS_VERIFY=false
ASGARDIAN_ALLOWED_HOSTS=localhost,127.0.0.1,asgardian.example.local
ASGARDIAN_ALLOWED_ORIGINS=http://localhost:5173,http://asgardian.example.local
ASGARDIAN_WORKFLOW_DIR=workflows
ASGARDIAN_WALL_TTL_SECONDS=86400
ASGARDIAN_POLL_INTERVAL_SECONDS=1.0
