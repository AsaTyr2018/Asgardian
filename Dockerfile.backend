FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 asgardian \
    && useradd --system --uid 10001 --gid asgardian --home-dir /app asgardian

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN python -m pip install .
COPY alembic.ini ./
COPY migrations ./migrations
COPY workflows ./workflows

USER 10001:10001
EXPOSE 8000
CMD ["asgardian-api"]
